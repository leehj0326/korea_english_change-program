import tkinter as tk
import json
import os

# --- 그림판 원본 색상 팔레트 정의 ---
COLOR_TOP_BAR = "#d1c7e0"
COLOR_TAB_BG = "#e6e0f0"
COLOR_CENTER_BG = "#ffffff"
COLOR_BTN_BG = "#f0f0f0"
COLOR_BOTTOM_BAR = "#505050"
COLOR_INPUT_BG = "#ffffff"

# --- 오토마타 변환 데이터 ---
CHO_LIST = ['ㄱ', 'ㄲ', 'ㄴ', 'ㄷ', 'ㄸ', 'ㄹ', 'ㅁ', 'ㅂ', 'ㅃ', 'ㅅ', 'ㅆ', 'ㅇ', 'ㅈ', 'ㅉ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ']
JUNG_LIST = ['ㅏ', 'ㅐ', 'ㅑ', 'ㅒ', 'ㅓ', 'ㅔ', 'ㅕ', 'ㅖ', 'ㅗ', 'ㅘ', 'ㅙ', 'ㅚ', 'ㅛ', 'ㅜ', 'ㅝ', 'ㅞ', 'ㅟ', 'ㅠ', 'ㅡ', 'ㅢ', 'ㅣ']
JONG_LIST = ['', 'ㄱ', 'ㄲ', 'ㄳ', 'ㄴ', 'ㄵ', 'ㄶ', 'ㄷ', 'ㄹ', 'ㄺ', 'ㄻ', 'ㄼ', 'ㄽ', 'ㄾ', 'ㄿ', 'ㅀ', 'ㅁ', 'ㅂ', 'ㅄ', 'ㅅ', 'ㅆ',
             'ㅇ', 'ㅈ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ']


ENG_TO_KOR = {
    'r': 'ㄱ', 'R': 'ㄲ', 's': 'ㄴ', 'e': 'ㄷ', 'E': 'ㄸ', 'f': 'ㄹ', 'a': 'ㅁ', 'q': 'ㅂ', 'Q': 'ㅃ',
    't': 'ㅅ', 'T': 'ㅆ', 'd': 'ㅇ', 'w': 'ㅈ', 'W': 'ㅉ', 'c': 'ㅊ', 'z': 'ㅋ', 'x': 'ㅌ', 'v': 'ㅍ', 'g': 'ㅎ',
    'k': 'ㅏ', 'o': 'ㅐ', 'i': 'ㅑ', 'O': 'ㅒ', 'j': 'ㅓ', 'p': 'ㅔ', 'u': 'ㅕ', 'P': 'ㅖ', 'h': 'ㅗ',
    'y': 'ㅛ', 'n': 'ㅜ', 'b': 'ㅠ', 'm': 'ㅡ', 'l': 'ㅣ'
}

COMPLEX_JUNG = {'ㅗㅏ': 'ㅘ', 'ㅗㅐ': 'ㅙ', 'ㅗㅣ': 'ㅚ', 'ㅜㅓ': 'ㅝ', 'ㅜㅔ': 'ㅞ', 'ㅜㅣ': 'ㅟ', 'ㅡㅣ': 'ㅢ'}
COMPLEX_JONG = {'ㄱㅅ': 'ㄳ', 'ㄴㅈ': 'ㄵ', 'ㄴㅎ': 'ㄶ', 'ㄹㄱ': 'ㄺ', 'ㄹㅁ': 'ㄻ', 'ㄹㅂ': 'ㄼ', 'ㄹㅅ': 'ㄽ', 'ㄹㅌ': 'ㄾ', 'ㄹㅍ': 'ㄿ',
                'ㄹㅎ': 'ㅀ', 'ㅂㅅ': 'ㅄ'}

KOR_TO_ENG = {
    'ㄱ': 'r', 'ㄲ': 'R', 'ㄴ': 's', 'ㄷ': 'e', 'ㄸ': 'E', 'ㄹ': 'f', 'ㅁ': 'a', 'ㅂ': 'q', 'ㅃ': 'Q',
    'ㅅ': 't', 'ㅆ': 'T', 'ㅇ': 'd', 'ㅈ': 'w', 'ㅉ': 'W', 'ㅊ': 'c', 'ㅋ': 'z', 'ㅌ': 'x', 'ㅍ': 'v', 'ㅎ': 'g',
    'ㅏ': 'k', 'ㅐ': 'o', 'ㅑ': 'i', 'ㅒ': 'O', 'ㅓ': 'j', 'ㅔ': 'p', 'ㅕ': 'u', 'ㅖ': 'P', 'ㅗ': 'h',
    'ㅘ': 'hk', 'ㅙ': 'ho', 'ㅚ': 'hl', 'ㅛ': 'y', 'ㅜ': 'n', 'ㅝ': 'nj', 'ㅞ': 'np', 'ㅟ': 'nl',
    'ㅠ': 'b', 'ㅡ': 'm', 'ㅢ': 'ml', 'ㅣ': 'l',
    'ㄳ': 'rt', 'ㄵ': 'sw', 'ㄶ': 'sg', 'ㄺ': 'fr', 'ㄻ': 'fa', 'ㄼ': 'ft', 'ㄽ': 'fx', 'ㄾ': 'fv', 'ㄿ': 'fg', 'ㅄ': 'qt'
}


def convert_eng_to_kor_automata(text):
    jamos = []
    for ch in text:
        if ch in ENG_TO_KOR:
            jamos.append(ENG_TO_KOR[ch])
        else:
            jamos.append(ch)

    result = []
    i = 0
    while i < len(jamos):
        if i < len(jamos) and jamos[i] in CHO_LIST:
            cho = jamos[i]
            i += 1
            if i < len(jamos) and jamos[i] in JUNG_LIST:
                jung = jamos[i]
                i += 1
                if i < len(jamos) and jamos[i] in JUNG_LIST:
                    combined = jung + jamos[i]
                    if combined in COMPLEX_JUNG:
                        jung = COMPLEX_JUNG[combined]
                        i += 1

                jong = ''
                if i < len(jamos) and jamos[i] in CHO_LIST:
                    next_jong = jamos[i]
                    if i + 1 < len(jamos) and jamos[i + 1] in JUNG_LIST:
                        pass
                    else:
                        jong = next_jong
                        i += 1
                        if i < len(jamos) and jong + jamos[i] in COMPLEX_JONG:
                            if i + 1 < len(jamos) and jamos[i + 1] in JUNG_LIST:
                                pass
                            else:
                                jong = COMPLEX_JONG[jong + jamos[i]]
                                i += 1

                cho_idx = CHO_LIST.index(cho)
                jung_idx = JUNG_LIST.index(jung)
                jong_idx = JONG_LIST.index(jong)
                syllable = chr(0xAC00 + cho_idx * 21 * 28 + jung_idx * 28 + jong_idx)
                result.append(syllable)
            else:
                result.append(cho)
        else:
            result.append(jamos[i])
            i += 1
    return "".join(result)


def convert_kor_to_eng(text):
    result = []
    for ch in text:
        if 'ㄱ' <= ch <= 'ㅣ' or '가' <= ch <= '힣':
            if '가' <= ch <= '힣':
                code = ord(ch) - 0xAC00
                jong_idx = code % 28
                jung_idx = ((code - jong_idx) // 28) % 21
                cho_idx = ((code - jong_idx) // 28) // 21

                cho = CHO_LIST[cho_idx]
                jung = JUNG_LIST[jung_idx]
                jong = JONG_LIST[jong_idx]

                result.append(KOR_TO_ENG.get(cho, cho))
                result.append(KOR_TO_ENG.get(jung, jung))
                if jong:
                    result.append(KOR_TO_ENG.get(jong, jong))
            else:
                result.append(KOR_TO_ENG.get(ch, ch))
        else:
            result.append(ch)
    return "".join(result)


def smart_convert(text):
    words = text.split(' ')
    converted_words = []

    for word in words:
        if not word:
            converted_words.append('')
            continue

        has_eng = any('a' <= c.lower() <= 'z' for c in word)
        if has_eng:
            converted_words.append(convert_eng_to_kor_automata(word))
        else:
            converted_words.append(convert_kor_to_eng(word))

    return ' '.join(converted_words)


class HangulTranslatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("한/영 변환기")
        self.root.geometry("850x650")

        self.data_file = "translator_save.json"
        self.tabs_data = self.load_data()
        self.tab_frames = {}
        self.tab_widgets = {}

        if not self.tabs_data:
            self.tabs_data = {"탭 1": ""}

        # --- 1. 상단 컨트롤 바 ---
        self.top_bar = tk.Frame(root, bg=COLOR_TOP_BAR, height=45)
        self.top_bar.pack(side=tk.TOP, fill=tk.X)

        self.tabs_scroll_frame = tk.Frame(self.top_bar, bg=COLOR_TOP_BAR)
        self.tabs_scroll_frame.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=5, pady=5)

        self.add_tab_btn = tk.Button(self.top_bar, text="+", font=("Arial", 12, "bold"), width=3,
                                     bg=COLOR_TAB_BG, relief="raised", bd=1, command=self.add_tab)
        self.add_tab_btn.pack(side=tk.RIGHT, padx=5, pady=5)

        # --- 2. 중앙 메인 작업 영역 ---
        self.center_frame = tk.Frame(root, bg=COLOR_CENTER_BG)
        self.center_frame.pack(side=tk.TOP, fill=tk.BOTH, expand=True)

        self.btn_frame = tk.Frame(self.center_frame, bg=COLOR_CENTER_BG)
        self.btn_frame.pack(side=tk.LEFT, fill=tk.Y, padx=5, pady=5)

        self.copy_btn = tk.Button(self.btn_frame, text="📋 복사", font=("Arial", 10, "bold"), width=6,
                                  bg=COLOR_BTN_BG, relief="raised", bd=1, command=self.copy_to_clipboard)
        self.copy_btn.pack(side=tk.TOP, pady=2)

        self.editor_container = tk.Frame(self.center_frame, bg=COLOR_CENTER_BG)
        self.editor_container.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=5, pady=5)

        # --- 3. 하단 입력 및 컨트롤 영역 ---
        self.bottom_bar = tk.Frame(root, bg=COLOR_BOTTOM_BAR, height=150)
        self.bottom_bar.pack(side=tk.BOTTOM, fill=tk.X)

        self.refresh_btn = tk.Button(self.bottom_bar, text="🔄", font=("Arial", 14),
                                     bg=COLOR_BTN_BG, relief="raised", bd=1, command=self.clear_input)
        self.refresh_btn.pack(side=tk.RIGHT, padx=10, pady=10)

        self.input_entry = tk.Text(self.bottom_bar, height=7, font=("Arial", 12), bg=COLOR_INPUT_BG, relief="sunken",
                                   bd=1)
        self.input_entry.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=10, pady=10)
        self.input_entry.bind("<KeyRelease>", self.on_key_released)

        # 탭 생성 및 초기화
        self.current_active_tab = None
        for name, content in self.tabs_data.items():
            self.create_tab_ui(name, content)

        first_tab = list(self.tabs_data.keys())[0]
        self.switch_tab(first_tab)

        self.root.protocol("WM_DELETE_WINDOW", self.on_closing)

    def create_tab_ui(self, name, content=""):
        tab_item_frame = tk.Frame(self.tabs_scroll_frame, bg=COLOR_TOP_BAR)
        tab_item_frame.pack(side=tk.LEFT, padx=2)

        name_btn = tk.Button(tab_item_frame, text=name, font=("Arial", 10), bd=1, relief="raised", bg=COLOR_TAB_BG,
                             command=lambda n=name: self.switch_tab(n))
        name_btn.pack(side=tk.LEFT, padx=(2, 1), pady=2)

        close_btn = tk.Button(tab_item_frame, text="X", font=("Arial", 9, "bold"), fg="#cc0000", bd=1, relief="raised",
                              bg=COLOR_TAB_BG,
                              command=lambda n=name: self.close_tab(n))
        close_btn.pack(side=tk.LEFT, padx=(1, 2), pady=2)

        name_btn.bind("<Double-Button-1>",
                      lambda e, n=name, f=tab_item_frame, btn=name_btn, c_btn=close_btn: self.start_inline_rename(n, f,
                                                                                                                  btn,
                                                                                                                  c_btn))
        name_btn.bind("<B1-Motion>", lambda e, f=tab_item_frame: self.on_tab_drag(e, f))

        text_area = tk.Text(self.editor_container, font=("Arial", 14), wrap=tk.WORD, bg=COLOR_CENTER_BG, bd=1,
                            relief="solid")
        text_area.insert("1.0", content)
        text_area.config(state="disabled")

        self.tab_frames[name] = {"frame": tab_item_frame, "name_btn": name_btn, "close_btn": close_btn}
        self.tab_widgets[name] = text_area

    def start_inline_rename(self, old_name, tab_item_frame, name_btn, close_btn):
        name_btn.pack_forget()
        close_btn.pack_forget()

        rename_entry = tk.Entry(tab_item_frame, font=("Arial", 10), bd=1, relief="solid")
        rename_entry.pack(side=tk.LEFT, padx=(2, 1), pady=2)
        rename_entry.insert(0, old_name)
        rename_entry.focus()
        rename_entry.select_range(0, tk.END)

        def save_rename(event=None):
            new_name = rename_entry.get().strip()
            rename_entry.destroy()

            if new_name and new_name != old_name and new_name not in self.tabs_data:
                self.tabs_data[new_name] = self.tabs_data.pop(old_name)
                self.tab_widgets[new_name] = self.tab_widgets.pop(old_name)
                self.tab_frames[new_name] = self.tab_frames.pop(old_name)

                name_btn.config(text=new_name, command=lambda n=new_name: self.switch_tab(n))
                name_btn.bind("<Double-Button-1>", lambda e, n=new_name, f=tab_item_frame, btn=name_btn,
                                                          c_btn=close_btn: self.start_inline_rename(n, f, btn, c_btn))
                name_btn.bind("<B1-Motion>", lambda e, f=tab_item_frame: self.on_tab_drag(e, f))

                close_btn.config(command=lambda n=new_name: self.close_tab(n))

                if self.current_active_tab == old_name:
                    self.current_active_tab = new_name

                self.save_data()
                active_name = new_name
            else:
                active_name = old_name

            name_btn.pack(side=tk.LEFT, padx=(2, 1), pady=2)
            close_btn.pack(side=tk.LEFT, padx=(1, 2), pady=2)
            self.switch_tab(active_name)

        rename_entry.bind("<Return>", save_rename)
        rename_entry.bind("<FocusOut>", save_rename)

    def on_tab_drag(self, event, frame):
        x_root = event.x_root
        for name, info in self.tab_frames.items():
            f = info["frame"]
            if f == frame:
                continue
            if f.winfo_rootx() < x_root < f.winfo_rootx() + f.winfo_width():
                if frame.winfo_rootx() < f.winfo_rootx():
                    frame.pack_configure(after=f)
                else:
                    frame.pack_configure(before=f)
                break

    def switch_tab(self, name):
        self.current_active_tab = name

        for widget in self.tab_widgets.values():
            widget.pack_forget()

        self.tab_widgets[name].pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

        self.input_entry.delete("1.0", tk.END)
        self.input_entry.insert("1.0", self.tabs_data.get(name, ""))

        for t_name, info in self.tab_frames.items():
            if t_name == name:
                info["name_btn"].config(bg="white", relief="sunken")
            else:
                info["name_btn"].config(bg=COLOR_TAB_BG, relief="raised")

    def add_tab(self):
        # '탭 1', '탭 2', '탭 3' 형식 중 사용 중이지 않은 가장 작은 번호 찾기
        idx = 1
        while True:
            new_name = f"탭 {idx}"
            if new_name not in self.tabs_data:
                break
            idx += 1

        self.tabs_data[new_name] = ""
        self.create_tab_ui(new_name, "")
        self.switch_tab(new_name)
        self.save_data()

    def close_tab(self, name):
        if len(self.tabs_data) <= 1:
            return

        self.tab_frames[name]["frame"].destroy()
        self.tab_widgets[name].destroy()

        del self.tab_frames[name]
        del self.tab_widgets[name]
        del self.tabs_data[name]

        remaining_tabs = list(self.tabs_data.keys())
        self.switch_tab(remaining_tabs[-1])
        self.save_data()

    def on_key_released(self, event):
        typed_text = self.input_entry.get("1.0", tk.END).rstrip('\n')
        if self.current_active_tab:
            converted_text = smart_convert(typed_text)

            self.tabs_data[self.current_active_tab] = converted_text
            target_area = self.tab_widgets[self.current_active_tab]
            target_area.config(state="normal")
            target_area.delete("1.0", tk.END)
            target_area.insert("1.0", converted_text)
            target_area.config(state="disabled")
            self.save_data()

    def copy_to_clipboard(self):
        if self.current_active_tab:
            text_to_copy = self.tabs_data.get(self.current_active_tab, "")
            self.root.clipboard_clear()
            self.root.clipboard_append(text_to_copy)

            self.copy_btn.config(text="✔ 완료", fg="green")
            self.root.after(1000, lambda: self.copy_btn.config(text="📋 복사", fg="black"))

    def clear_input(self):
        self.input_entry.delete("1.0", tk.END)
        if self.current_active_tab:
            target_area = self.tab_widgets[self.current_active_tab]
            target_area.config(state="normal")
            target_area.delete("1.0", tk.END)
            target_area.config(state="disabled")
            self.tabs_data[self.current_active_tab] = ""
            self.save_data()

    def load_data(self):
        if os.path.exists(self.data_file):
            try:
                with open(self.data_file, "r", encoding="utf-8") as f:
                    return json.load(f)
            except:
                return {}
        return {"탭 1": ""}

    def save_data(self):
        try:
            with open(self.data_file, "w", encoding="utf-8") as f:
                json.dump(self.tabs_data, f, ensure_ascii=False, indent=4)
        except Exception as e:
            print(f"저장 실패: {e}")

    def on_closing(self):
        self.save_data()
        self.root.destroy()


if __name__ == "__main__":
    root = tk.Tk()
    app = HangulTranslatorApp(root)
    root.mainloop()
